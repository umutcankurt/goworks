# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dist-electron
*.local

# Secrets
secrets/
# electron/secrets/ altındaki TS source dosyaları kod tabanına aittir; secrets/ deseninden hariç tut.
!electron/secrets/
!electron/secrets/*.ts
*.pem
*.p12
*.key
service-account*.json

# Local runtime data — encrypted vault + SQLite DB (contain client secret /
# service-account key / branding). Runtime lives in the OS userData dir, never
# in the repo; these globs are defense-in-depth so they can never be committed.
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
goworks.db
*.enc
vault.enc

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment Variables
.env
.env.local
.env.production

# Agent data
.agents/
.claude/

# Internal development artifacts (not part of the public project)
memory-bank/
plans/
referans-tasarimlar/

# Release builds (electron-builder output)
release/

# Database backups
*.dump

# TypeScript incremental build cache (tsconfig references + composite)
*.tsbuildinfo

# tsconfig.node.json composite project compile output (vite.config.ts → JS+DTS)
vite.config.js
vite.config.d.ts

