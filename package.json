{
  "name": "goworks",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "description": "Open-source Electron desktop app for Google Workspace administration — bulk user lifecycle management, offboarding/onboarding, Gmail signature deployment, and group management. Runs fully locally, no server required.",
  "keywords": [
    "google-workspace",
    "google-workspace-admin",
    "google-admin-sdk",
    "workspace-management",
    "user-lifecycle-management",
    "offboarding",
    "onboarding",
    "gmail-signature",
    "gmail-signature-manager",
    "google-groups",
    "bulk-operations",
    "electron",
    "desktop-app",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/umutcankurt/goworks#readme",
  "bugs": {
    "url": "https://github.com/umutcankurt/goworks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umutcankurt/goworks.git"
  },
  "license": "Apache-2.0",
  "author": "umutcankurt (https://github.com/umutcankurt)",
  "scripts": {
    "predev": "node scripts/check-native-abi.mjs",
    "dev": "vite",
    "demo": "VITE_DEMO=1 VITE_DEMO_LANG=tr vite",
    "demo:en": "VITE_DEMO=1 VITE_DEMO_LANG=en vite",
    "demo:onboarding": "VITE_DEMO=1 VITE_DEMO_ONBOARDING=1 VITE_DEMO_LANG=tr vite",
    "demo:onboarding:en": "VITE_DEMO=1 VITE_DEMO_ONBOARDING=1 VITE_DEMO_LANG=en vite",
    "demo:check": "node scripts/check-demo-coverage.mjs",
    "prebuild": "node -e \"const fs=require('fs');for(const d of ['dist','dist-electron'])fs.rmSync(d,{recursive:true,force:true})\"",
    "build": "tsc && vite build && node scripts/check-bundle-secrets.mjs && electron-builder -mw",
    "postbuild": "electron-rebuild -f -w better-sqlite3",
    "secrets:check": "node scripts/check-bundle-secrets.mjs",
    "rebuild": "electron-rebuild -f -w better-sqlite3 && node scripts/sqlite-binary.mjs cache electron",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "pretest": "node scripts/sqlite-binary.mjs use node",
    "test": "vitest",
    "posttest": "node scripts/sqlite-binary.mjs use electron",
    "test:prepare": "node scripts/sqlite-binary.mjs prepare-test",
    "i18n:check": "node scripts/check-i18n-parity.mjs",
    "postlint": "node scripts/check-demo-coverage.mjs",
    "abi:check": "node scripts/check-native-abi.mjs",
    "prepare": "husky || true",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node scripts/sqlite-binary.mjs cache electron"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@types/papaparse": "^5.5.2",
    "@types/react-dropzone": "^4.2.2",
    "better-sqlite3": "^12.9.0",
    "bottleneck": "^2.19.5",
    "clsx": "^2.1.1",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.2",
    "google-auth-library": "^10.5.0",
    "googleapis": "^173.0.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.575.0",
    "papaparse": "^5.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/react-router-dom": "^5.3.3",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.24",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.0.18"
  },
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=11.0.0"
  }
}
